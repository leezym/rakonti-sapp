{
  "name": "rakonti-sapp",
  "author": "Elizabeth Carolina Moncada",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Rakonti: Sistema Interactivo Para Crear Narrativas",
  "private": true,
  "main": "build/electron.js",
  "homepage": "./",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@reduxjs/toolkit": "1.8.5",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "13.4.0",
    "@testing-library/user-event": "13.5.0",
    "chokidar": "4.0.3",
    "docx": "9.5.1",
    "file-saver": "2.0.5",
    "html-to-text": "9.0.5",
    "jszip": "3.10.1",
    "quill": "^2.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-modal": "^3.16.3",
    "react-quill": "^2.0.0",
    "react-redux": "8.0.2",
    "react-router-dom": "^6.30.6",
    "react-scripts": "^5.0.0",
    "redux-persist": "6.0.0",
    "safe-regex-test": "1.1.0",
    "styled-components": "5.3.5",
    "web-vitals": "2.1.4"
  },
  "scripts": {
    "frontend-local:backend-local": "react-scripts start",
    "frontend-local:backend-prod": "cross-env REACT_APP_API_URL=http://cards-transfer.gl.at.ply.gg:55303/rakonti react-scripts start",
    "frontend-prod:backend-prod": "react-scripts build",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run frontend-local:backend-local\" \"npm run electron:start\"",
    "preelectron:start": "node -e \"const fs=require('fs');fs.mkdirSync('build',{recursive:true});fs.copyFileSync('public/electron.js','build/electron.js')\"",
    "electron:start": "wait-on tcp:3000 && electron .",
    "electron:build": "npm run frontend-prod:backend-prod && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.rakonti.sapp",
    "productName": "Rakonti",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "../rakonti-api",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules",
          "!.env.local",
          "!.env.remote",
          "!.git",
          "!.gitignore",
          "!db/*.sql",
          "!db/*.png"
        ]
      }
    ],
    "afterPack": "./scripts/afterPack.js",
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "styled-components@5.3.5": true
  }
}
